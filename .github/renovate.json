{
  "extends": [
    "config:recommended",
    "schedule:weekly",
    ":enableVulnerabilityAlerts",
    "security:minimumReleaseAgeNpm"
  ],
  "semanticCommits": "enabled",
  "semanticCommitType": "chore",
  "semanticCommitScope": "deps",
  "patch": {
    "enabled": false
  },
  "labels": [
    "dependencies"
  ],
  "packageRules": [
    {
      "matchManagers": [
        "gomod"
      ],
      "addLabels": [
        "go"
      ]
    },
    {
      "matchManagers": [
        "npm"
      ],
      "addLabels": [
        "npm"
      ]
    },
    {
      "matchFileNames": ["codyze-console/**/webapp/**"],
      "groupName": "Codyze Console WebApp dependencies"
    }
  ]
}
