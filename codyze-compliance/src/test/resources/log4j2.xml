<Configuration status="WARN">
	<Appenders>
		<Console name="STDOUT" target="SYSTEM_OUT">
			<PatternLayout pattern="%d{HH:mm:ss,SSS} %-5p %C{1} %m%n"/>
			<ThresholdFilter level="${sys:cpg.log.level:-DEBUG}"/>
		</Console>
	</Appenders>
	<Loggers>
		<Logger level="${sys:cpg.log.level:-DEBUG}" name="de.fraunhofer.aisec"/>
		<Root level="${sys:cpg.log.level:-DEBUG}">
			<AppenderRef ref="STDOUT"/>
		</Root>
	</Loggers>
</Configuration>